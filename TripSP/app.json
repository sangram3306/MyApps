{
  "expo": {
    "name": "TripSP",
    "slug": "Travezy",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/TripSP-Logo-Compass.jpg",
    "scheme": "travezy",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#030F13",
    "splash": {
      "image": "./assets/images/transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#030F13"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "backgroundColor": "#030F13",
      "predictiveBackGestureEnabled": false,
      "splash": {
        "backgroundColor": "#030F13"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/TripSP-Logo.png",
        "backgroundColor": "#030F13"
      },
      "package": "com.sangramdev.Travezy"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/transparent.png",
          "resizeMode": "contain",
          "backgroundColor": "#030F13"
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fa87ae8c-2488-492d-86a7-108663972574"
      }
    }
  }
}
